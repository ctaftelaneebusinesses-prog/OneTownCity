# Backend Environment Configuration
# Copy to .env and fill in real values — never commit .env to git

# ── PostgreSQL ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://prajith:CHANGE_ME@localhost:5432/onetowncity
# DATABASE_URL=postgresql://prajith:CHANGE_ME@localhost:5432/onetowncity?sslmode=require

# ── Server ───────────────────────────────────────────────────────────────────
BIND_ADDR=0.0.0.0:8080
# For HTTPS (TLS handled by reverse proxy or tower-tls)
# TLS_CERT_PATH=./certs/localhost.pem
# TLS_KEY_PATH=./certs/localhost-key.pem

# ── Cloudflare R2 (S3-compatible) ────────────────────────────────────────────
# Set these via AWS CLI profile OR export directly
AWS_ACCESS_KEY_ID=CHANGE_ME_R2_ACCESS_KEY
AWS_SECRET_ACCESS_KEY=CHANGE_ME_R2_SECRET_KEY
AWS_ENDPOINT_URL=https://ACCOUNT_ID.r2.cloudflarestorage.com
AWS_REGION=auto
R2_BUCKET_NAME=onetowncity-assets

# ── Sentry ───────────────────────────────────────────────────────────────────
SENTRY_DSN=https://CHANGE_ME@oXXXXXX.ingest.sentry.io/XXXXXXX

# ── OpenTelemetry ─────────────────────────────────────────────────────────────
# Leave empty to use stdout exporter (dev). Set for production OTLP endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Rust logging ─────────────────────────────────────────────────────────────
RUST_LOG=one_town_city=debug,tower_http=debug,axum=debug,sqlx=warn
